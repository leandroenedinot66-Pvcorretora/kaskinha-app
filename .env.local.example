# Copie este arquivo para ".env.local" (uso local) e preencha com os valores reais.
# Na Vercel, essas mesmas variáveis vão em Project Settings > Environment Variables.

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-service-role-key

# Gerado com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=coloque-aqui-a-chave-publica
VAPID_PRIVATE_KEY=coloque-aqui-a-chave-privada
VAPID_SUBJECT=mailto:seuemail@exemplo.com
